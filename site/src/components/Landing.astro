---
import { Image } from 'astro:assets';
import { Code } from '@astrojs/starlight/components';
import Goals from './Goals.astro';
import { installCommand, links, protocolMatrix, strings, type Lang, type Screen } from '../landing';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const docs = (path: string) => `${import.meta.env.BASE_URL}${lang === 'en' ? 'en/' : ''}${path}`;

// Screenshots from the inherited Mikan interface, one set per language.
const shots = import.meta.glob<{ default: ImageMetadata }>('../../../.github/assets/screens/*/*.webp', {
	eager: true,
});
const shot = (name: string) => shots[`../../../.github/assets/screens/${lang}/${name}.webp`].default;
const screens = Object.keys(t.screens.items) as Screen[];
// The roadmap is a permanent part of the free-core project overview.
const roadmapVisible = true;
---

<div class="landing not-content">
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-copy">
			{
				roadmapVisible ? (
					<a class="roadmap-badge" href="#roadmap-title">
						<span class="dot" aria-hidden="true" />
						{t.roadmap.badge}
						<svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
							<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
				) : null
			}
			<h1 id="hero-title">{t.hero.title}</h1>
			<p class="lead">{t.hero.lead}</p>
			<div class="install">
				<Code code={installCommand} lang="bash" frame="none" />
			</div>
			<p class="req">{t.hero.requirements}</p>
			<div class="actions">
				<a class="btn btn-primary" href={docs('start/install/')}>
					{t.hero.primary}
					<svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</a>
				<a class="btn btn-ghost" href={docs('start/overview/')}>{t.hero.secondary}</a>
				<a class="btn btn-ghost" href={links.github}>GitHub</a>
			</div>
		</div>
		<div class="hero-art">
			<svg class="fruit" viewBox="0 0 280 280" role="img" aria-label={t.hero.art} xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="mikan-glow"><stop stop-color="#ff9148" stop-opacity=".36"/><stop offset="1" stop-color="#ff9148" stop-opacity="0"/></radialGradient>
    <linearGradient id="mikan-skin" x1=".18" y1="0" x2=".82" y2="1"><stop stop-color="#ffc166"/><stop offset=".45" stop-color="#ff8a32"/><stop offset="1" stop-color="#d94b14"/></linearGradient>
    <linearGradient id="mikan-leaf" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#a5e67d"/><stop offset="1" stop-color="#26734a"/></linearGradient>
    <filter id="mikan-shadow" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="10"/></filter>
  </defs>
  <circle cx="140" cy="140" r="135" fill="url(#mikan-glow)"/>
  <g fill="none" stroke="#ff8a32" stroke-width="1.5" opacity=".4">
    <ellipse cx="140" cy="144" rx="112" ry="57" transform="rotate(-24 140 144)"/>
    <ellipse cx="140" cy="144" rx="120" ry="79" transform="rotate(31 140 144)" opacity=".6"/>
    <circle cx="35" cy="157" r="4" fill="#62c6df"/><circle cx="229" cy="82" r="5" fill="#ff8a32"/><circle cx="222" cy="221" r="4" fill="#72dca0"/>
  </g>
  <ellipse cx="140" cy="230" rx="66" ry="10" fill="#000" opacity=".23" filter="url(#mikan-shadow)"/>
  <path d="M130 63 C113 38 128 21 151 18 C159 39 150 56 130 63Z" fill="url(#mikan-leaf)"/>
  <path d="M139 58 C158 32 190 37 200 16 C204 47 174 68 139 58Z" fill="url(#mikan-leaf)"/>
  <path d="M137 62 C136 48 144 35 155 29" fill="none" stroke="#75441e" stroke-width="6" stroke-linecap="round"/>
  <path d="M55 122 C62 83 103 67 130 77 C161 65 204 80 221 117 C246 160 215 209 175 222 C151 239 112 226 95 213 C58 197 39 159 55 122Z" fill="url(#mikan-skin)"/>
  <path d="M76 116 C93 91 113 88 127 92 M82 190 C102 211 126 218 146 211 M170 90 C197 104 207 130 201 151" fill="none" stroke="#ffd591" stroke-width="6" stroke-linecap="round" opacity=".65"/>
  <ellipse cx="93" cy="153" rx="17" ry="11" fill="#ffb3a0" opacity=".5"/><ellipse cx="184" cy="153" rx="17" ry="11" fill="#ffb3a0" opacity=".5"/>
  <circle cx="108" cy="142" r="5.5" fill="#6f2b10"/><circle cx="168" cy="142" r="5.5" fill="#6f2b10"/>
  <path d="M119 166 Q139 185 159 166" fill="none" stroke="#6f2b10" stroke-width="5" stroke-linecap="round"/>
  <g transform="translate(164 188)">
    <rect x="0" y="0" width="43" height="24" rx="8" fill="#fff2d9" opacity=".92"/>
    <text x="21.5" y="16.5" text-anchor="middle" fill="#b94712" font-family="Arial,sans-serif" font-size="12" font-weight="700">2.0</text>
  </g>
</svg>
			<span class="shade" aria-hidden="true"></span>
		</div>
	</section>

	{
		roadmapVisible ? (
			<section class="block roadmap" aria-labelledby="roadmap-title">
				<header class="block-head roadmap-head">
					<div>
						<h2 id="roadmap-title">{t.roadmap.title}</h2>
						<p>{t.roadmap.lead}</p>
					</div>
					<a class="more" href={docs('support/')}>{t.roadmap.all}</a>
				</header>
				<Goals lang={lang} compact />
			</section>
		) : null
	}

	<section class="block" aria-labelledby="screens-title">
		<header class="block-head">
			<h2 id="screens-title">{t.screens.title}</h2>
			<p>{t.screens.lead}</p>
		</header>
		<div class="shots">
			<div class="shot-tabs" role="radiogroup" aria-label={t.screens.label}>
				{
					screens.map((s, i) => (
						<>
							<input type="radio" name="shot" id={`shot-${s}`} value={s} checked={i === 0} />
							<label for={`shot-${s}`}>{t.screens.items[s][0]}</label>
						</>
					))
				}
			</div>
			{
				screens.map((s, i) => (
					<figure class="shot" data-shot={s}>
						<div class="frame">
							<Image
								src={shot(s)}
								alt={`Mikan 2.0 · ${t.screens.items[s][0]}`}
								format="webp"
								widths={[720, 1080, 1600, 2160]}
								sizes="(min-width: 72rem) 1056px, calc(100vw - 2rem)"
								loading={i === 0 ? 'eager' : 'lazy'}
							/>
						</div>
						<figcaption>{t.screens.items[s][1]}</figcaption>
					</figure>
				))
			}
		</div>
	</section>

	<section class="block" aria-labelledby="features-title">
		<header class="block-head">
			<h2 id="features-title">{t.features.title}</h2>
		</header>
		<ul class="features">
			{
				t.features.items.map((f) => (
					<li>
						<h3>
							<a href={f.href}>{f.title}</a>
						</h3>
						<p>{f.text}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="block split" aria-labelledby="protocols-title">
		<header class="block-head">
			<h2 id="protocols-title">{t.protocols.title}</h2>
			<p>{t.protocols.lead}</p>
			<a class="more" href={t.protocols.moreHref}>{t.protocols.more}</a>
		</header>
		<div class="matrix-wrap">
			<table class="matrix">
				<thead>
					<tr>
						{t.protocols.headers.map((h, i) => (i === 0 ? <th scope="col">{h}</th> : <th scope="col" class="c">{h}</th>))}
					</tr>
				</thead>
				<tbody>
					{
						protocolMatrix.map(([name, clash, xray, singbox, shared]) => (
							<tr>
								<th scope="row">
									{name}
									{shared && <sup>1</sup>}
								</th>
								{[clash, xray, singbox].map((ok) => (
									<td class="c">
										<span class={ok ? 'yes' : 'no'} aria-hidden="true" />
										<span class="sr-only">{ok ? t.protocols.yes : t.protocols.no}</span>
									</td>
								))}
							</tr>
						))
					}
				</tbody>
			</table>
			<p class="note">{t.protocols.note}</p>
		</div>
	</section>

	<section class="block phones" aria-labelledby="phones-title">
		<div class="phones-copy">
			<h2 id="phones-title">{t.phones.title}</h2>
			<p>{t.phones.text}</p>
			<a class="more" href={t.phones.href}>{t.phones.link}</a>
		</div>
		<div class="phones-art">
			<Image src={shot('phone-subscription')} alt={t.phones.alts[0]} widths={[260, 390, 520]} sizes="(min-width: 50rem) 260px, 42vw" class="phone" />
			<Image src={shot('phone-dashboard')} alt={t.phones.alts[1]} widths={[260, 390, 520]} sizes="(min-width: 50rem) 260px, 42vw" class="phone phone-back" />
		</div>
	</section>

	<section class="block cta" aria-labelledby="cta-title">
		<div class="cta-main">
			<h2 id="cta-title">{t.cta.title}</h2>
			<p>{t.cta.text}</p>
			<Code code={installCommand} lang="bash" frame="none" />
			<div class="actions">
				<a class="btn btn-primary" href={docs('start/install/')}>{t.cta.docs}</a>
				<a class="btn btn-ghost" href={links.github}>{t.cta.github}</a>
			</div>
		</div>
		<aside class="sponsor" aria-labelledby="sponsor-title">
			<h3 id="sponsor-title">{t.cta.sponsorTitle}</h3>
			<p>{t.cta.sponsorText}</p>
			<div class="actions">
				<a class="btn btn-accent" href={docs('support/')}>{t.cta.sponsor}</a>
				<a class="btn btn-ghost" href={links.github}>{t.cta.github}</a>
			</div>
		</aside>
	</section>
</div>

<style>
	.landing {
		--gap: clamp(3.5rem, 2rem + 6vw, 7rem);
		color: var(--mk-text);
	}

	.landing h1,
	.landing h2 {
		font-family: var(--mk-font-display);
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--mk-ink);
		text-wrap: balance;
	}

	.landing h2 {
		font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
		line-height: 1.15;
		margin: 0;
	}

	.landing p {
		margin: 0;
		text-wrap: pretty;
	}

	/* ---------- hero ---------- */

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
		padding-block: clamp(1rem, 4vw, 3.5rem) 0;
	}

	.hero-art {
		position: relative;
		order: -1;
		justify-self: start;
		width: 168px;
	}

	.fruit {
		display: block;
		width: 100%;
		height: auto;
		position: relative;
		z-index: 1;
		animation: float 7s ease-in-out infinite;
		filter: drop-shadow(0 18px 24px rgba(160, 70, 10, 0.18));
	}

	.shade {
		position: absolute;
		left: 18%;
		right: 22%;
		bottom: -6%;
		height: 9%;
		border-radius: 50%;
		background: rgba(140, 60, 10, 0.2);
		filter: blur(6px);
		animation: shade 7s ease-in-out infinite;
	}

	:global([data-theme='dark']) .shade {
		background: rgba(0, 0, 0, 0.55);
	}

	@keyframes float {
		50% {
			transform: translateY(-8px) rotate(-1.5deg);
		}
	}

	@keyframes shade {
		50% {
			transform: scaleX(0.86);
			opacity: 0.7;
		}
	}

	.hero h1 {
		font-size: clamp(2.125rem, 1.3rem + 3.6vw, 3.75rem);
		line-height: 1.04;
		margin: 0;
		max-width: 14ch;
	}

	.lead {
		margin-top: 1.25rem !important;
		font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
		line-height: 1.55;
		max-width: 36rem;
		color: var(--mk-text);
	}

	.install {
		margin-top: 1.75rem;
	}

	.req {
		margin-top: 0.75rem !important;
		font-size: 0.875rem;
		color: var(--mk-muted);
		max-width: 40rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0 1.25rem;
		border-radius: 12px;
		font-weight: 600;
		font-size: 0.9375rem;
		text-decoration: none;
		transition:
			background-color 0.2s var(--mk-ease),
			border-color 0.2s var(--mk-ease),
			transform 0.12s var(--mk-ease);
	}

	.btn:active {
		transform: translateY(1px);
	}

	.btn-primary {
		background: var(--mk-fill);
		color: var(--mk-on-fill);
	}

	.btn-primary:hover {
		background: color-mix(in srgb, var(--mk-fill) 86%, var(--mk-accent));
	}

	.btn-ghost {
		border: 1px solid var(--mk-hairline-strong);
		color: var(--mk-ink);
		background: var(--mk-surface);
	}

	.btn-ghost:hover {
		border-color: color-mix(in srgb, var(--mk-accent) 60%, transparent);
	}

	.btn-accent {
		background: var(--mk-accent);
		color: #1b1006;
	}

	.btn-accent:hover {
		background: color-mix(in srgb, var(--mk-accent) 88%, #fff);
	}

	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
			gap: 3rem;
		}
		.hero-art {
			order: 0;
			width: 300px;
			justify-self: end;
			margin-inline-end: 1rem;
		}
	}

	/* ---------- blocks ---------- */

	.block {
		margin-top: var(--gap);
	}

	.block-head {
		max-width: 40rem;
		margin-bottom: 1.75rem;
	}

	.block-head p {
		margin-top: 0.75rem;
		font-size: 1.0625rem;
	}

	.more {
		display: inline-block;
		margin-top: 1rem;
		color: var(--mk-accent-text);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--mk-accent-text) 40%, transparent);
		text-underline-offset: 0.25em;
	}

	.more:hover {
		text-decoration-color: currentColor;
	}

	/* ---------- roadmap ---------- */

	.roadmap-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
		padding: 0.375rem 0.75rem 0.375rem 0.625rem;
		border-radius: 999px;
		background: var(--mk-accent-soft);
		border: 1px solid color-mix(in srgb, var(--mk-accent) 30%, transparent);
		color: var(--mk-accent-text);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition: border-color 0.2s var(--mk-ease);
	}

	.roadmap-badge:hover {
		border-color: var(--mk-accent);
	}

	.roadmap-badge:focus-visible {
		outline: 2px solid var(--mk-accent);
		outline-offset: 2px;
	}

	.roadmap-badge b {
		display: inline-grid;
		place-items: center;
		min-width: 1.25rem;
		height: 1.25rem;
		padding: 0 0.25rem;
		border-radius: 999px;
		background: var(--mk-orange);
		color: var(--mk-on-orange);
		font-size: 0.75rem;
	}

	.roadmap-badge .dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--mk-orange);
	}

	.roadmap-head {
		max-width: none;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.5rem 2rem;
	}

	.roadmap-head > div {
		max-width: 40rem;
	}

	.roadmap-head .more {
		margin-top: 0;
	}

	/* The strip comes right after the hero: closer than the other blocks. */
	.roadmap {
		margin-top: calc(var(--gap) * 0.6);
	}

	/* ---------- screenshots ---------- */

	.shot-tabs {
		position: relative;
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		padding: 0.25rem;
		margin-bottom: 1rem;
		border: 1px solid var(--mk-hairline);
		border-radius: 14px;
		background: var(--mk-surface);
	}

	.shot-tabs input {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
	}

	.shot-tabs label {
		padding: 0.5rem 0.875rem;
		border-radius: 10px;
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--mk-muted);
		cursor: pointer;
		transition:
			background-color 0.2s var(--mk-ease),
			color 0.2s var(--mk-ease);
	}

	.shot-tabs label:hover {
		color: var(--mk-ink);
	}

	.shot-tabs input:checked + label {
		background: var(--mk-fill);
		color: var(--mk-on-fill);
	}

	.shot-tabs input:focus-visible + label {
		outline: 2px solid var(--mk-accent);
		outline-offset: 2px;
	}

	.shot {
		display: none;
		margin: 0;
	}

	.shot[data-shot='dashboard'] {
		display: block;
	}

	.shots:has(input:checked) .shot {
		display: none;
	}

	.shots:has(#shot-dashboard:checked) [data-shot='dashboard'],
	.shots:has(#shot-users:checked) [data-shot='users'],
	.shots:has(#shot-inbounds:checked) [data-shot='inbounds'],
	.shots:has(#shot-telegram:checked) [data-shot='telegram'],
	.shots:has(#shot-settings:checked) [data-shot='settings'] {
		display: block;
		animation: appear 0.35s var(--mk-ease);
	}

	@keyframes appear {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	.frame {
		border-radius: var(--mk-radius-lg);
		overflow: hidden;
		border: 1px solid var(--mk-hairline);
		box-shadow: var(--mk-shadow-lg);
		background: var(--mk-surface-2);
		aspect-ratio: 2160 / 1350;
	}

	.frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	figcaption {
		margin-top: 1rem;
		font-size: 0.9375rem;
		color: var(--mk-muted);
		max-width: 40rem;
	}

	/* ---------- features ---------- */

	.features {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
		column-gap: 2.5rem;
	}

	.features li {
		padding-block: 1.25rem 1.5rem;
		border-top: 1px solid var(--mk-hairline-strong);
	}

	.features h3 {
		margin: 0 0 0.5rem;
		font-size: 1.0625rem;
		font-weight: 650;
		line-height: 1.35;
	}

	.features h3 a {
		color: var(--mk-ink);
		text-decoration: none;
	}

	.features h3 a:hover {
		color: var(--mk-accent-text);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.features p {
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	/* ---------- protocol matrix ---------- */

	.split {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.5rem 4rem;
	}

	@media (min-width: 60rem) {
		.split {
			grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
			align-items: start;
		}
		.split h2 {
			font-size: clamp(1.5rem, 1rem + 1vw, 1.875rem);
		}
		.split .block-head {
			position: sticky;
			top: calc(var(--sl-nav-height) + 2rem);
		}
	}

	.matrix-wrap {
		position: relative;
		overflow-x: auto;
		border: 1px solid var(--mk-hairline);
		border-radius: var(--mk-radius);
		background: var(--mk-surface);
	}

	.matrix {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}

	.matrix :is(th, td) {
		padding: 0.625rem 1rem;
		border-bottom: 1px solid var(--mk-hairline);
		text-align: start;
	}

	.matrix thead th {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--mk-muted);
		vertical-align: bottom;
	}

	.matrix tbody th {
		font-weight: 500;
		color: var(--mk-ink);
		white-space: nowrap;
	}

	.matrix .c {
		text-align: center;
		width: 7rem;
	}

	.matrix sup {
		color: var(--mk-muted);
		margin-inline-start: 0.125rem;
	}

	.yes,
	.no {
		display: inline-block;
		vertical-align: middle;
	}

	.yes {
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 50%;
		background: var(--mk-accent);
	}

	.no {
		width: 0.75rem;
		height: 1.5px;
