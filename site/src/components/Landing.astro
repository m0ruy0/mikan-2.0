---
import { Image } from 'astro:assets';
import { Code } from '@astrojs/starlight/components';
import Goals from './Goals.astro';
import { installCommand, links, protocolMatrix, strings, type Lang, type Screen } from '../landing';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const docs = (path: string) => `${import.meta.env.BASE_URL}${lang === 'en' ? 'en/' : ''}${path}`;

// Screenshots from the inherited Mikan interface, one set per language.
const shots = import.meta.glob<{ default: ImageMetadata }>('../../../.github/assets/screens/*/*.webp', {
	eager: true,
});
const shot = (name: string) => shots[`../../../.github/assets/screens/${lang}/${name}.webp`].default;
const screens = Object.keys(t.screens.items) as Screen[];
// The roadmap is a permanent part of the free-core project overview.
const roadmapVisible = true;
---

<div class="landing not-content">
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-copy">
			{
				roadmapVisible ? (
					<a class="roadmap-badge" href="#roadmap-title">
						<span class="dot" aria-hidden="true" />
						{t.roadmap.badge}
						<svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14">
							<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
				) : null
			}
			<h1 id="hero-title">{t.hero.title}</h1>
			<p class="lead">{t.hero.lead}</p>
			<div class="install">
				<Code code={installCommand} lang="bash" frame="none" />
			</div>
			<p class="req">{t.hero.requirements}</p>
			<div class="actions">
				<a class="btn btn-primary" href={docs('start/install/')}>
					{t.hero.primary}
					<svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				</a>
				<a class="btn btn-ghost" href={docs('support/')}>{t.hero.secondary}</a>
				<a class="btn btn-ghost" href={links.github}>GitHub</a>
			</div>
		</div>
		<div class="hero-art">
			<svg class="fruit" viewBox="0 0 380 320" role="img" aria-label={t.hero.art} xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="network-glow"><stop stop-color="#ff853d" stop-opacity=".35"/><stop offset="1" stop-color="#ff853d" stop-opacity="0"/></radialGradient>
    <linearGradient id="server-top" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#39475d"/><stop offset="1" stop-color="#171f2b"/></linearGradient>
    <linearGradient id="server-left" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#202b3c"/><stop offset="1" stop-color="#101720"/></linearGradient>
    <linearGradient id="server-right" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#171f2d"/><stop offset="1" stop-color="#080d14"/></linearGradient>
    <filter id="network-shadow" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="8"/></filter>
  </defs>
  <circle cx="190" cy="156" r="154" fill="url(#network-glow)"/>
  <g fill="none" stroke="#ff853d" stroke-width="1.4" opacity=".37">
    <ellipse cx="190" cy="161" rx="154" ry="67" transform="rotate(-24 190 161)"/>
    <ellipse cx="190" cy="161" rx="165" ry="98" transform="rotate(31 190 161)" opacity=".7"/>
    <path d="M25 107 C91 70 126 75 159 102 S229 182 292 129 S343 111 357 122"/>
    <path d="M35 222 C95 199 126 220 161 243 S244 270 328 212"/>
    <circle cx="31" cy="107" r="5" fill="#4bb9d8"/><circle cx="351" cy="122" r="5" fill="#ff853d"/>
    <circle cx="328" cy="212" r="5" fill="#73dda0"/><circle cx="80" cy="250" r="4" fill="#ff853d"/>
  </g>
  <ellipse cx="190" cy="274" rx="103" ry="14" fill="#000" opacity=".28" filter="url(#network-shadow)"/>
  <g transform="translate(190 163)">
    <path d="M0 -112 100 -57 0 -2 -100 -57Z" fill="url(#server-top)" stroke="#ff853d" stroke-width="1.7" stroke-opacity=".85"/>
    <path d="M-100 -57 0 -2 0 117 -100 61Z" fill="url(#server-left)" stroke="#344155" stroke-width="1.2"/>
    <path d="M100 -57 0 -2 0 117 100 61Z" fill="url(#server-right)" stroke="#344155" stroke-width="1.2"/>
    <path d="M-100 -22 0 33 0 55 -100 0Z" fill="#293648" stroke="#ff853d" stroke-opacity=".42"/>
    <path d="M100 -22 0 33 0 55 100 0Z" fill="#1b2534" stroke="#ff853d" stroke-opacity=".42"/>
    <path d="M-100 15 0 70 0 91 -100 37Z" fill="#202b3b"/>
    <path d="M100 15 0 70 0 91 100 37Z" fill="#141d2a"/>
    <path d="M-78 -43 -27 -15 M-78 -17 -27 11 M-78 20 -27 48" stroke="#ff853d" stroke-width="2.6" stroke-linecap="round"/>
    <path d="M78 -43 27 -15 M78 -17 27 11 M78 20 27 48" stroke="#ff853d" stroke-width="2.6" stroke-linecap="round"/>
    <g fill="#78e0a1"><circle cx="-82" cy="-47" r="4"/><circle cx="-82" cy="-21" r="4"/><circle cx="-82" cy="16" r="4"/><circle cx="82" cy="-47" r="4"/><circle cx="82" cy="-21" r="4"/><circle cx="82" cy="16" r="4"/></g>
    <circle cx="0" cy="-58" r="32" fill="#ff853d" opacity=".16"/>
    <circle cx="0" cy="-58" r="22" fill="#ff853d"/>
    <path d="M-7 -79 C-14 -87 -5 -94 1 -96 C6 -86 2 -81 -2 -78Z" fill="#68401d"/>
    <path d="M1 -80 C8 -91 19 -87 22 -97 C25 -83 13 -74 1 -80Z" fill="#78c56b"/>
    <path d="M-14 -62 C-11 -75 3 -80 9 -72 C20 -70 22 -60 17 -51 C10 -42 -3 -42 -11 -50 C-15 -54 -16 -58 -14 -62Z" fill="#ffb04c" opacity=".75"/>
  </g>
  <g transform="translate(52 73)">
    <rect width="58" height="47" rx="12" fill="#151e2a" stroke="#ff853d" stroke-opacity=".65"/>
    <rect x="10" y="10" width="37" height="7" rx="3.5" fill="#344255"/>
    <rect x="10" y="25" width="24" height="6" rx="3" fill="#344255"/>
    <circle cx="43" cy="28" r="3" fill="#76dfa0"/>
  </g>
  <g transform="translate(270 82)">
    <rect width="60" height="48" rx="12" fill="#151e2a" stroke="#ff853d" stroke-opacity=".65"/>
    <path d="M15 17h29M15 25h21M15 33h25" stroke="#52627a" stroke-width="3" stroke-linecap="round"/>
    <circle cx="46" cy="17" r="3.5" fill="#ff853d"/>
  </g>
  <g transform="translate(39 221)">
    <rect width="55" height="41" rx="11" fill="#151e2a" stroke="#4bb9d8" stroke-opacity=".7"/>
    <path d="M13 14 20 20 13 26 M27 26h15" fill="none" stroke="#77d9ef" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
  <g transform="translate(291 221)">
    <rect width="52" height="41" rx="11" fill="#151e2a" stroke="#73dda0" stroke-opacity=".7"/>
    <path d="M12 20h28 M26 9v22 M18 12 12 20l6 8 M34 12l6 8-6 8" fill="none" stroke="#73dda0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</svg>
			<span class="shade" aria-hidden="true"></span>
		</div>
	</section>

	{
		roadmapVisible ? (
			<section class="block roadmap" aria-labelledby="roadmap-title">
				<header class="block-head roadmap-head">
					<div>
						<h2 id="roadmap-title">{t.roadmap.title}</h2>
						<p>{t.roadmap.lead}</p>
					</div>
					<a class="more" href={docs('support/')}>{t.roadmap.all}</a>
				</header>
				<Goals lang={lang} compact />
			</section>
		) : null
	}

	<section class="block" aria-labelledby="screens-title">
		<header class="block-head">
			<h2 id="screens-title">{t.screens.title}</h2>
			<p>{t.screens.lead}</p>
		</header>
		<div class="shots">
			<div class="shot-tabs" role="radiogroup" aria-label={t.screens.label}>
				{
					screens.map((s, i) => (
						<>
							<input type="radio" name="shot" id={`shot-${s}`} value={s} checked={i === 0} />
							<label for={`shot-${s}`}>{t.screens.items[s][0]}</label>
						</>
					))
				}
			</div>
			{
				screens.map((s, i) => (
					<figure class="shot" data-shot={s}>
						<div class="frame">
							<Image
								src={shot(s)}
								alt={`Mikan 2.0 · ${t.screens.items[s][0]}`}
								format="webp"
								widths={[720, 1080, 1600, 2160]}
								sizes="(min-width: 72rem) 1056px, calc(100vw - 2rem)"
								loading={i === 0 ? 'eager' : 'lazy'}
							/>
						</div>
						<figcaption>{t.screens.items[s][1]}</figcaption>
					</figure>
				))
			}
		</div>
	</section>

	<section class="block" aria-labelledby="features-title">
		<header class="block-head">
			<h2 id="features-title">{t.features.title}</h2>
		</header>
		<ul class="features">
			{
				t.features.items.map((f) => (
					<li>
						<h3>
							<a href={f.href}>{f.title}</a>
						</h3>
						<p>{f.text}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="block split" aria-labelledby="protocols-title">
		<header class="block-head">
			<h2 id="protocols-title">{t.protocols.title}</h2>
			<p>{t.protocols.lead}</p>
			<a class="more" href={t.protocols.moreHref}>{t.protocols.more}</a>
		</header>
		<div class="matrix-wrap">
			<table class="matrix">
				<thead>
					<tr>
						{t.protocols.headers.map((h, i) => (i === 0 ? <th scope="col">{h}</th> : <th scope="col" class="c">{h}</th>))}
					</tr>
				</thead>
				<tbody>
					{
						protocolMatrix.map(([name, clash, xray, singbox, shared]) => (
							<tr>
								<th scope="row">
									{name}
									{shared && <sup>1</sup>}
								</th>
								{[clash, xray, singbox].map((ok) => (
									<td class="c">
										<span class={ok ? 'yes' : 'no'} aria-hidden="true" />
										<span class="sr-only">{ok ? t.protocols.yes : t.protocols.no}</span>
									</td>
								))}
							</tr>
						))
					}
				</tbody>
			</table>
			<p class="note">{t.protocols.note}</p>
		</div>
	</section>

	<section class="block phones" aria-labelledby="phones-title">
		<div class="phones-copy">
			<h2 id="phones-title">{t.phones.title}</h2>
			<p>{t.phones.text}</p>
			<a class="more" href={t.phones.href}>{t.phones.link}</a>
		</div>
		<div class="phones-art">
			<Image src={shot('phone-subscription')} alt={t.phones.alts[0]} widths={[260, 390, 520]} sizes="(min-width: 50rem) 260px, 42vw" class="phone" />
			<Image src={shot('phone-dashboard')} alt={t.phones.alts[1]} widths={[260, 390, 520]} sizes="(min-width: 50rem) 260px, 42vw" class="phone phone-back" />
		</div>
	</section>

	<section class="block cta" aria-labelledby="cta-title">
		<div class="cta-main">
			<h2 id="cta-title">{t.cta.title}</h2>
			<p>{t.cta.text}</p>
			<Code code={installCommand} lang="bash" frame="none" />
			<div class="actions">
				<a class="btn btn-primary" href={docs('start/install/')}>{t.cta.docs}</a>
				<a class="btn btn-ghost" href={links.github}>{t.cta.github}</a>
			</div>
		</div>
		<aside class="sponsor" aria-labelledby="sponsor-title">
			<h3 id="sponsor-title">{t.cta.sponsorTitle}</h3>
			<p>{t.cta.sponsorText}</p>
			<div class="actions">
				<a class="btn btn-accent" href={docs('support/')}>{t.cta.sponsor}</a>
				<a class="btn btn-ghost" href={links.github}>{t.cta.github}</a>
			</div>
		</aside>
	</section>
</div>

<style>
	.landing {
		--gap: clamp(3.5rem, 2rem + 6vw, 7rem);
		color: var(--mk-text);
	}

	.landing h1,
	.landing h2 {
		font-family: var(--mk-font-display);
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--mk-ink);
		text-wrap: balance;
	}

	.landing h2 {
		font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
		line-height: 1.15;
		margin: 0;
	}

	.landing p {
		margin: 0;
		text-wrap: pretty;
	}

	/* ---------- hero ---------- */

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
		padding-block: clamp(1rem, 4vw, 3.5rem) 0;
	}

	.hero-art {
		position: relative;
		order: -1;
		justify-self: start;
		width: 168px;
	}

	.fruit {
		display: block;
		width: 100%;
		height: auto;
		position: relative;
		z-index: 1;
		animation: float 7s ease-in-out infinite;
		filter: drop-shadow(0 18px 24px rgba(160, 70, 10, 0.18));
	}

	.shade {
		position: absolute;
		left: 18%;
		right: 22%;
		bottom: -6%;
		height: 9%;
		border-radius: 50%;
		background: rgba(140, 60, 10, 0.2);
		filter: blur(6px);
		animation: shade 7s ease-in-out infinite;
	}

	:global([data-theme='dark']) .shade {
		background: rgba(0, 0, 0, 0.55);
	}

	@keyframes float {
		50% {
			transform: translateY(-8px) rotate(-1.5deg);
		}
	}

	@keyframes shade {
		50% {
			transform: scaleX(0.86);
			opacity: 0.7;
		}
	}

	.hero h1 {
		font-size: clamp(2.125rem, 1.3rem + 3.6vw, 3.75rem);
		line-height: 1.04;
		margin: 0;
		max-width: 14ch;
	}

	.lead {
		margin-top: 1.25rem !important;
		font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
		line-height: 1.55;
		max-width: 36rem;
		color: var(--mk-text);
	}

	.install {
		margin-top: 1.75rem;
	}

	.req {
		margin-top: 0.75rem !important;
		font-size: 0.875rem;
		color: var(--mk-muted);
		max-width: 40rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0 1.25rem;
		border-radius: 12px;
		font-weight: 600;
		font-size: 0.9375rem;
		text-decoration: none;
		transition:
			background-color 0.2s var(--mk-ease),
			border-color 0.2s var(--mk-ease),
			transform 0.12s var(--mk-ease);
	}

	.btn:active {
		transform: translateY(1px);
	}

	.btn-primary {
		background: var(--mk-fill);
		color: var(--mk-on-fill);
	}

	.btn-primary:hover {
		background: color-mix(in srgb, var(--mk-fill) 86%, var(--mk-accent));
	}

	.btn-ghost {
		border: 1px solid var(--mk-hairline-strong);
		color: var(--mk-ink);
		background: var(--mk-surface);
	}

	.btn-ghost:hover {
		border-color: color-mix(in srgb, var(--mk-accent) 60%, transparent);
	}

	.btn-accent {
		background: var(--mk-accent);
		color: #1b1006;
	}

	.btn-accent:hover {
		background: color-mix(in srgb, var(--mk-accent) 88%, #fff);
	}

	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
			gap: 3rem;
		}
		.hero-art {
			order: 0;
			width: 300px;
			justify-self: end;
			margin-inline-end: 1rem;
		}
	}

	/* ---------- blocks ---------- */

	.block {
		margin-top: var(--gap);
	}

	.block-head {
		max-width: 40rem;
		margin-bottom: 1.75rem;
	}

	.block-head p {
		margin-top: 0.75rem;
		font-size: 1.0625rem;
	}

	.more {
		display: inline-block;
		margin-top: 1rem;
		color: var(--mk-accent-text);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--mk-accent-text) 40%, transparent);
		text-underline-offset: 0.25em;
	}

	.more:hover {
		text-decoration-color: currentColor;
	}

	/* ---------- roadmap ---------- */

	.roadmap-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
		padding: 0.375rem 0.75rem 0.375rem 0.625rem;
		border-radius: 999px;
		background: var(--mk-accent-soft);
		border: 1px solid color-mix(in srgb, var(--mk-accent) 30%, transparent);
		color: var(--mk-accent-text);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition: border-color 0.2s var(--mk-ease);
	}

	.roadmap-badge:hover {
		border-color: var(--mk-accent);
	}

	.roadmap-badge:focus-visible {
		outline: 2px solid var(--mk-accent);
		outline-offset: 2px;
	}

	.roadmap-badge b {
		display: inline-grid;
		place-items: center;
		min-width: 1.25rem;
		height: 1.25rem;
		padding: 0 0.25rem;
		border-radius: 999px;
		background: var(--mk-orange);
		color: var(--mk-on-orange);
		font-size: 0.75rem;
	}

	.roadmap-badge .dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--mk-orange);
	}

	.roadmap-head {
		max-width: none;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.5rem 2rem;
	}

	.roadmap-head > div {
		max-width: 40rem;
	}

	.roadmap-head .more {
		margin-top: 0;
	}

	/* The strip comes right after the hero: closer than the other blocks. */
	.roadmap {
		margin-top: calc(var(--gap) * 0.6);
	}

	/* ---------- screenshots ---------- */

	.shot-tabs {
		position: relative;
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		padding: 0.25rem;
		margin-bottom: 1rem;
		border: 1px solid var(--mk-hairline);
		border-radius: 14px;
		background: var(--mk-surface);
	}

	.shot-tabs input {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
	}

	.shot-tabs label {
		padding: 0.5rem 0.875rem;
		border-radius: 10px;
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--mk-muted);
		cursor: pointer;
		transition:
			background-color 0.2s var(--mk-ease),
			color 0.2s var(--mk-ease);
	}

	.shot-tabs label:hover {
		color: var(--mk-ink);
	}

	.shot-tabs input:checked + label {
		background: var(--mk-fill);
		color: var(--mk-on-fill);
	}

	.shot-tabs input:focus-visible + label {
		outline: 2px solid var(--mk-accent);
		outline-offset: 2px;
	}

	.shot {
		display: none;
		margin: 0;
	}

	.shot[data-shot='dashboard'] {
		display: block;
	}

	.shots:has(input:checked) .shot {
		display: none;
	}

	.shots:has(#shot-dashboard:checked) [data-shot='dashboard'],
	.shots:has(#shot-users:checked) [data-shot='users'],
	.shots:has(#shot-inbounds:checked) [data-shot='inbounds'],
	.shots:has(#shot-telegram:checked) [data-shot='telegram'],
	.shots:has(#shot-settings:checked) [data-shot='settings'] {
		display: block;
		animation: appear 0.35s var(--mk-ease);
	}

	@keyframes appear {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	.frame {
		border-radius: var(--mk-radius-lg);
		overflow: hidden;
		border: 1px solid var(--mk-hairline);
		box-shadow: var(--mk-shadow-lg);
		background: var(--mk-surface-2);
		aspect-ratio: 2160 / 1350;
	}

	.frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	figcaption {
		margin-top: 1rem;
		font-size: 0.9375rem;
		color: var(--mk-muted);
		max-width: 40rem;
	}

	/* ---------- features ---------- */

	.features {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
		column-gap: 2.5rem;
	}

	.features li {
		padding-block: 1.25rem 1.5rem;
		border-top: 1px solid var(--mk-hairline-strong);
	}

	.features h3 {
		margin: 0 0 0.5rem;
		font-size: 1.0625rem;
		font-weight: 650;
		line-height: 1.35;
	}

	.features h3 a {
		color: var(--mk-ink);
		text-decoration: none;
	}

	.features h3 a:hover {
