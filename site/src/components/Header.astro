---
// The site header: logo, search from the content column on, then one row of 36px controls:
// theme, language, GitHub and Support. Phones keep GitHub and Support as icon buttons; the
// theme and language move to the menu (on the landing, which has no menu, a language link
// stays in the header).
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { Icon } from '@astrojs/starlight/components';
import { links, strings } from '../landing';
import { otherLocaleUrl } from '../locale';

const { lang: routeLang, hasSidebar } = Astro.locals.starlightRoute;
const lang = routeLang === 'en' ? 'en' : 'ru';
const t = strings[lang].header;
const other = lang === 'en' ? 'ru' : 'en';
const homeHref = lang === 'en' ? `${import.meta.env.BASE_URL}en/` : import.meta.env.BASE_URL;
const installHref = `${import.meta.env.BASE_URL}${lang === 'en' ? 'en/' : ''}start/install/`;
---

<div class:list={['header', { 'landing-header': !hasSidebar }]}>
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	{
		!hasSidebar && (
			<nav class="landing-nav print:hidden" aria-label={t.navLabel}>
				<a href={homeHref}>{t.navHome}</a>
				<a href="#features-title">{t.navFeatures}</a>
				<a href={installHref}>{t.navDocs}</a>
				<a href="#screens-title">{t.navDemo}</a>
			</nav>
		)
	}
	<div class="search sl-flex print:hidden">
		<Search />
	</div>
	<div class="controls print:hidden">
		<div class="prefs">
			<ThemeSelect />
			<LanguageSelect />
		</div>
		{
			!hasSidebar && (
				<a class="hbtn hbtn-ghost hbtn-lang" href={otherLocaleUrl(Astro.url.pathname, other)} hreflang={other} lang={other} aria-label={t.otherLanguage}>
					{other.toUpperCase()}
				</a>
			)
		}
		<a class="hbtn hbtn-ghost hbtn-github" href={links.github} aria-label={t.githubLabel}>
			<Icon name="github" size="1rem" />
			<span class="hbtn-text">GitHub</span>
		</a>
		<a class="hbtn hbtn-accent hbtn-support" href={!hasSidebar ? installHref : links.sponsor} aria-label={!hasSidebar ? t.startLabel : t.supportLabel}>
			<Icon name={!hasSidebar ? "arrow-right" : "book-open"} size="1rem" />
			<span class="hbtn-text">{!hasSidebar ? t.start : t.support}</span>
		</a>
	</div>
</div>

<style>
	.header {
		display: flex;
		gap: 0.5rem;
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}

	.title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}

	.search {
		margin-inline-start: auto;
	}

	.controls,
	.prefs {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.prefs {
		display: none;
	}

	/* One family of buttons: 36px, 10px radius, the same type. */
	.hbtn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		box-sizing: border-box;
		height: 2.25rem;
		min-width: 2.25rem;
		padding-inline: 0;
		border: 1px solid transparent;
		border-radius: 10px;
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 0.15s var(--mk-ease),
			border-color 0.15s var(--mk-ease);
	}

	.hbtn :global(svg) {
		flex: none;
	}

	.hbtn:focus-visible {
		outline: 2px solid var(--mk-accent);
		outline-offset: 2px;
	}

	.hbtn-text {
		display: none;
	}

	.hbtn-ghost {
		border-color: var(--mk-hairline-strong);
		background: var(--mk-surface);
		color: var(--mk-ink);
	}

	.hbtn-ghost:hover {
		border-color: color-mix(in srgb, var(--mk-ink) 32%, transparent);
	}

	.hbtn-accent {
		background: var(--mk-orange);
		color: var(--mk-on-orange);
	}

	.hbtn-accent:hover {
		background: var(--mk-orange-hover);
	}

	/* Phones: the search is an icon button of the same size. */
	.search :global(button[data-open-modal]) {
		box-sizing: border-box;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--mk-hairline-strong);
		border-radius: 10px;
		background: var(--mk-surface);
		color: var(--mk-ink);
		font-size: 1rem;
	}

	.hbtn-lang {
		padding-inline: 0.5rem;
		font-family: var(--sl-font-mono);
		font-size: 0.8125rem;
	}

	@media (min-width: 50rem) {
		/* Starlight's grid: the search starts where the content column starts. */
		:global(:root[data-has-sidebar]) {
			--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
		}
		:global(:root:not([data-has-toc])) {
			--__toc-width: 0rem;
		}
		.header {
			--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
			--__main-column-fr: calc(
				(
						100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
							(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
							var(--sl-content-width)
					) / 2
			);
			display: grid;
			grid-template-columns:
				minmax(calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))), auto)
				minmax(0, 1fr)
				auto;
			gap: var(--sl-nav-gap);
			align-content: center;
		}
		.search {
			margin-inline-start: 0;
		}
		/* The search starts at the content column and fills the room up to the controls. */
		.search :global(button[data-open-modal]) {
			justify-content: flex-start;
			width: 100%;
			max-width: none;
			font-size: var(--sl-text-sm);
			color: var(--mk-muted);
			border-radius: 10px;
			border-color: var(--mk-hairline-strong);
			background: var(--mk-surface);
		}
		.prefs {
			display: flex;
		}
		.hbtn-lang {
			display: none;
		}
	}

	/* Between tablet and a laptop the search needs the room: no shortcut hint. */
	@media (min-width: 50rem) and (max-width: 63.99rem) {
		.search :global(button[data-open-modal] kbd) {
			display: none;
		}
	}

	@media (min-width: 64rem) {
		.hbtn-support {
			padding-inline: 0.875rem;
		}
		.hbtn-support .hbtn-text {
			display: inline;
		}
	}

	@media (min-width: 72rem) {
		.hbtn-github {
			padding-inline: 0.875rem;
		}
		.hbtn-github .hbtn-text {
			display: inline;
		}
	}
/* Homepage header: compact product navigation instead of an empty search bar. */
.header.landing-header { display: flex; gap: 1rem; }
.landing-header .search { display: none; }
.landing-header .landing-nav { display: flex; align-items: center; justify-content: center; gap: clamp(.75rem, 1.4vw, 1.5rem); margin-inline: auto; white-space: nowrap; }
.landing-nav a { position: relative; padding-block: .55rem; color: var(--mk-muted); font-size: .875rem; font-weight: 550; text-decoration: none; transition: color .2s var(--mk-ease); }
.landing-nav a:hover { color: var(--mk-ink); }
.landing-nav a::after { content: ''; position: absolute; left: 0; right: 100%; bottom: .15rem; height: 2px; border-radius: 999px; background: var(--mk-accent); transition: right .22s var(--mk-ease); }
.landing-nav a:hover::after { right: 0; }
.landing-header .controls { margin-inline-start: 0; flex: none; }
@media (max-width: 75rem) { .landing-header .landing-nav { gap: .75rem; } .landing-nav a { font-size: .8125rem; } }
@media (max-width: 63.99rem) { .header.landing-header { display: flex; } .landing-header .landing-nav { display: none; } .landing-header .controls { margin-inline-start: auto; } }
</style>
