---
type Lang = 'ru' | 'en';

type RoadmapItem = {
  id: string;
  title: Record<Lang, string>;
  about: Record<Lang, string>;
};

const { lang = 'ru', compact = false } = Astro.props as { lang?: Lang; compact?: boolean };

const items: RoadmapItem[] = [
  {
    id: 'pterodactyl',
    title: { ru: 'Ноды на Pterodactyl', en: 'Pterodactyl nodes' },
    about: {
      ru: 'Запуск ноды на обычном игровом хостинге без root и Docker внутри контейнера. Понадобится проверить выделенные TCP/UDP-порты провайдера.',
      en: 'Run a node on regular game hosting without root or Docker inside the container. The provider’s TCP/UDP allocations must be verified.',
    },
  },
  {
    id: 'migration',
    title: { ru: 'Перенос панели на другой сервер', en: 'Move the panel to another server' },
    about: {
      ru: 'Резервная копия, проверка восстановления, перенос клиентов, тарифов, настроек и нод, возможность отката.',
      en: 'Back up and validate restoration of users, plans, settings and nodes, with a rollback path.',
    },
  },
  {
    id: 'external',
    title: { ru: 'Внешние подписки как ноды', en: 'External subscriptions as nodes' },
    about: {
      ru: 'Добавление внешней подписки, безопасное обновление конфигурации и сохранение последней рабочей версии.',
      en: 'Import external subscriptions, refresh them safely and keep the last known-good configuration.',
    },
  },
  {
    id: 'admin-bot',
    title: { ru: 'Административный Telegram-бот', en: 'Telegram admin bot' },
    about: {
      ru: 'Управление клиентами, подписками и нодами с проверкой прав, подтверждением опасных действий и аудитом.',
      en: 'Manage users, subscriptions and nodes with permission checks, confirmations for risky actions and audit logging.',
    },
  },
  {
    id: 'addons',
    title: { ru: 'Магазин аддонов и готовых ботов', en: 'Addon store and ready-made bots' },
    about: {
      ru: 'Несколько отдельных ботов, платёжные адаптеры и интеграции в расширяемом каталоге.',
      en: 'Multiple independent bots, payment adapters and integrations in an extensible catalog.',
    },
  },
  {
    id: 'api',
    title: { ru: 'API для собственных ботов', en: 'API for custom bots' },
    about: {
      ru: 'Документированный API, ключи с ограниченными правами и webhooks для сторонних разработчиков.',
      en: 'A documented API, scoped keys and webhooks for third-party developers.',
    },
  },
];

const active = compact ? items.slice(0, 3) : items;
const t = lang === 'ru'
  ? { status: 'В плане', core: 'Входит в бесплатную основную версию' }
  : { status: 'Planned', core: 'Included in the free core' };
---

<div class:list={['goals', 'not-content', { compact }]}>
  <ul class="grid">
    {active.map((item) => (
      <li class="goal" id={item.id}>
        <div class="head">
          <h3>{item.title[lang]}</h3>
          <span class="pill planned">{t.status}</span>
        </div>
        <p class="about">{item.about[lang]}</p>
        <div class="foot">
          <span>{t.core}</span>
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  .goals { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 50rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .compact .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .compact { margin-top: 0; }
  .goal { display: flex; flex-direction: column; gap: .75rem; padding: 1.25rem; border-radius: var(--mk-radius-lg); background: var(--mk-surface); border: 1px solid var(--mk-hairline); }
  .head { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; }
  h3 { margin: 0; font-size: 1.0625rem; font-weight: 650; line-height: 1.35; color: var(--mk-ink); }
  .pill { flex: none; padding: .125rem .625rem; border-radius: 999px; font-size: .75rem; font-weight: 600; white-space: nowrap; background: var(--mk-accent-soft); color: var(--mk-accent-text); }
  .about { margin: 0; font-size: .9375rem; color: var(--mk-text); }
  .foot { margin-top: auto; display: flex; align-items: center; gap: .5rem; font-size: .8125rem; color: var(--mk-muted); }
</style>
